{
  "name": "kurarium",
  "version": "0.5.1",
  "description": "Local and SMB media viewer for Windows",
  "private": true,
  "main": "electron/dist/main.js",
  "author": "kumagai31",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumagai10303-creator/kurarium.git"
  },
  "bugs": {
    "url": "https://github.com/kumagai10303-creator/kurarium/issues"
  },
  "homepage": "https://github.com/kumagai10303-creator/kurarium#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck && tsc -p electron/tsconfig.json",
    "test": "npm --prefix backend test",
    "icons": "node scripts/generate-icons.mjs",
    "fetch:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg.ps1",
    "fetch:ffmpeg-source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg-source.ps1",
    "prepackage:installer": "npm run icons",
    "package:installer": "electron-builder --win nsis --x64 --publish never",
    "prepackage:portable": "npm run icons",
    "package:portable": "electron-builder --config electron-builder.portable.yml --win zip --x64 --publish never",
    "dist:installer": "npm run build && npm run package:installer",
    "dist:portable": "npm run build && npm run package:portable",
    "dist": "npm run build && npm run package:installer && npm run package:portable",
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs",
    "test:e2e": "npm run build:backend && npm run build:frontend && playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@napi-rs/canvas": "^1.0.13",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "node-smb2": "^1.3.5",
    "pdfjs-dist": "^6.4.299",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
